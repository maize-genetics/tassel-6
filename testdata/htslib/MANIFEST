[large-pos]
# One contig of length 4000000000 and one record at 3000000000, past Int.MAX_VALUE.
# htslib 1.25 indexes it (CSI depth 6) and answers a region query. The GenotypeTable boundary is what cannot hold the position.
# tabix refuses it. There is no .tbi, so there is no tabix -l output.
command = bgzip -c (one record at 3000000000 on chr1 of length 4000000000)
file = htslib/large-pos/large_pos.vcf.gz
command = bcftools index -c htslib/large-pos/large_pos.vcf.gz
file = htslib/large-pos/large_pos.vcf.gz.csi
