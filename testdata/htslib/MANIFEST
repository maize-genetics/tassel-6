[wheat]
# Synthetic wheat-like VCF. Contig lengths are IWGSC RefSeq v2.1 Table 4 Length (bp),
# Zhu et al., The Plant Genome 14, e20112 (2021), PMC8360199.
# Names are chr1A through chr7D. chr6D is declared and has no records.
# bcftools index -s omits a contig with no records, so chr6D is not in that table.
# Four samples. Filler SNPs are on chr3B from a fixed LCG seed so the file spans 20 to 50 BGZF blocks.
# A sequence deletion at chr3B:536870000 (ACGT to A) is the ADR-0021 example.
# One <DEL> carries INFO/END across several 16384 bp CSI bins. Another <DEL> carries only INFO/SVLEN.
# tabix -p vcf refuses the file because a coordinate past 2^29 cannot be stored in a TBI. There is no .tbi.
lengths_source = Zhu et al., The Plant Genome 14, e20112 (2021), PMC8360199, Table 4, Length (bp)
empty_contig = chr6D
samples = s1 s2 s3 s4
seed = 80
filler_count = 32000
command = bgzip -c (synthetic wheat VCF, seed 80, 32000 chr3B filler sites)
file = htslib/wheat/wheat.vcf.gz
bgzf_data_blocks = 25
command = bcftools index -c htslib/wheat/wheat.vcf.gz
file = htslib/wheat/wheat.vcf.gz.csi
csi_min_shift = 14
csi_depth = 6
command = tabix -p vcf htslib/wheat/wheat.vcf.gz
tabix_refused = [E::hts_idx_check_range] Region 589999999..590000000 cannot be stored in a tbi index. Try using a csi index
index_s_omits_empty_contigs = true
command = bcftools index -s htslib/wheat/wheat.vcf.gz
file = htslib/wheat/index-s.txt
# No tabix -l output: the file has no TBI. Contig names and counts are the index -s table.

[wheat-regions]
# A region that starts inside the sequence deletion, the END deletion, or the SVLEN deletion
# is returned for --regions-overlap record and omitted for --regions-overlap pos.
