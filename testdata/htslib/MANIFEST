[variants]
# One small VCF, then six compressions of those same bytes.
# plain gzip is Apple gzip -n, not BGZF. Regenerating it with GNU gzip would not match.
# concatenated is two gzip members. mid-eof is two bgzip members, so a 28-byte EOF block sits in the middle.
# no-eof drops that trailing 28-byte block. truncated keeps the first 40 bytes, inside the first block.
# bgzip 1.25 text mode flushes after the VCF header, so the bgzipped source is a header block plus a body block.
# bad-crc flips the first CRC32 byte of the last data block, the four bytes immediately before that block ISIZE.
file = htslib/variants/source.vcf
command = gzip -n -c htslib/variants/source.vcf
file = htslib/variants/plain.vcf.gz
split_at = 117
command = gzip -n -c (bytes 0..116 of htslib/variants/source.vcf)
command = gzip -n -c (bytes 117..end of htslib/variants/source.vcf)
command = cat
file = htslib/variants/concatenated.vcf.gz
command = bgzip -c (bytes 0..116 of htslib/variants/source.vcf)
command = bgzip -c (bytes 117..end of htslib/variants/source.vcf)
command = cat
file = htslib/variants/mid-eof.vcf.gz
command = bgzip -c htslib/variants/source.vcf
command = drop the final 28-byte BGZF EOF block
file = htslib/variants/no-eof.vcf.gz
command = bgzip -c htslib/variants/source.vcf
command = keep the first 40 bytes
file = htslib/variants/truncated.vcf.gz
command = bgzip -c htslib/variants/source.vcf
crc_byte_offset = 243
command = xor the first CRC32 byte of the last data block with 1
file = htslib/variants/bad-crc.vcf.gz
