# TASSEL 5 golden outputs for TASSEL 6 parity tests (ADR-0009).
# Generated by scripts/generate-goldens.sh. Do not edit by hand.
#
# Paths are relative to testdata/, and every command runs from there.
#   tassel5      = java -Xmx4g -cp sTASSEL.jar net.maizegenetics.pipeline.TasselPipeline -maxThreads 4
#   tassel5-full = tassel5 with scripts/golden/DoubleFormat.java ahead of sTASSEL.jar on the
#                  classpath, so table doubles are written with Double.toString instead of
#                  TASSEL's five-significant-digit format. Nothing else changes.
# -maxThreads 4 fixes Centered IBS kinship's site blocks at 1,000 sites, so its float
# summation order does not depend on the host's core count.
#
# Tolerances, per output file:
#   exact          identical text after normalizing line endings
#   abs X          every number within X absolutely; text cells identical
#   rel X          every number within X relative to the golden value; text cells identical
#   ... up-to-sign each numeric column may be negated as a whole before comparing
#   ... rows-unordered the data rows may be compared in any order: both sides are put in a
#                  canonical row order first, so nothing a row's position implies is compared
#                  (TASSEL 5's PCA eigenvalues come out of an SVD that does not sort them)
#   format         headers, row labels, and layout identical; numbers are checked in the
#                  .full.txt twin (PCA signs are arbitrary, so TASSEL-rounded text can differ)

[tassel5]
version = 5.2.98
tag = v5.2.98
artifact = https://github.com/maize-genetics/tassel/releases/download/v5.2.98/tassel-5-standalone-v5.2.98.tar.gz
sha256 = 52e7675aec4c7ab34bb6e0cfe94b26709f8fd8dd761b4d7892b3aa0e38df3c6e
java = 21+

[inputs]
artifact = https://github.com/maize-genetics/tassel_test_data/releases/download/v1.0.0/tassel_test_data_v1.tar.gz
sha256 = 6a0c515f7c3e6053f6c4cc31705da3e2e655a055e8bf927859fd2ee2fb757424
tutorial/mdp_genotype.hmp.txt = dataFiles/Tutorial/mdp_genotype.hmp.txt
tutorial/mdp_genotype_w_depth.vcf = dataFiles/Tutorial/mdp_genotype_w_depth.vcf

[hapmap]
description = HapMap export of the tutorial HapMap (reader and writer round trip)
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -export golden/hapmap/mdp_genotype -exportType Hapmap
golden/hapmap/mdp_genotype.hmp.txt = exact

[vcf]
description = HapMap export of the tutorial VCF (VCF reader)
command = tassel5 -vcf tutorial/mdp_genotype_w_depth.vcf -export golden/vcf/mdp_genotype_w_depth -exportType Hapmap
golden/vcf/mdp_genotype_w_depth.hmp.txt = exact

[summary]
description = GenotypeSummaryPlugin defaults: overview, allele, site, and taxa tables
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -GenotypeSummaryPlugin -endPlugin -export golden/summary/overview,golden/summary/alleles,golden/summary/sites,golden/summary/taxa -exportType Table
command = tassel5-full -h tutorial/mdp_genotype.hmp.txt -GenotypeSummaryPlugin -endPlugin -export golden/summary/overview.full,golden/summary/alleles.full,golden/summary/sites.full,golden/summary/taxa.full -exportType Table
golden/summary/overview.txt = exact
golden/summary/alleles.txt = exact
golden/summary/sites.txt = exact
golden/summary/taxa.txt = exact
golden/summary/overview.full.txt = abs 1e-12
golden/summary/alleles.full.txt = abs 1e-12
golden/summary/sites.full.txt = abs 1e-12
golden/summary/taxa.full.txt = abs 1e-12

[filter-sites]
description = FilterSiteBuilderPlugin parameter sets; outputs are HapMap exports
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -FilterSiteBuilderPlugin -siteMinCount 270 -endPlugin -export golden/filter-sites/min-count-270,golden/filter-sites/min-count-270.filter -exportType Hapmap
golden/filter-sites/min-count-270.hmp.txt = exact
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -FilterSiteBuilderPlugin -siteMinAlleleFreq 0.05 -siteMaxAlleleFreq 0.4 -endPlugin -export golden/filter-sites/maf-0.05-0.4,golden/filter-sites/maf-0.05-0.4.filter -exportType Hapmap
golden/filter-sites/maf-0.05-0.4.hmp.txt = exact
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -FilterSiteBuilderPlugin -siteRangeFilterType SITES -startSite 100 -endSite 599 -endPlugin -export golden/filter-sites/site-range-100-599,golden/filter-sites/site-range-100-599.filter -exportType Hapmap
golden/filter-sites/site-range-100-599.hmp.txt = exact
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -FilterSiteBuilderPlugin -siteRangeFilterType POSITIONS -startChr 5 -startPos 1000000 -endChr 6 -endPos 50000000 -endPlugin -export golden/filter-sites/position-range-5-6,golden/filter-sites/position-range-5-6.filter -exportType Hapmap
golden/filter-sites/position-range-5-6.hmp.txt = exact
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -FilterSiteBuilderPlugin -removeMinorSNPStates true -endPlugin -export golden/filter-sites/remove-minor-snp-states,golden/filter-sites/remove-minor-snp-states.filter -exportType Hapmap
golden/filter-sites/remove-minor-snp-states.hmp.txt = exact
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -FilterSiteBuilderPlugin -siteMinCount 250 -siteMinAlleleFreq 0.1 -maxHeterozygous 0.02 -endPlugin -export golden/filter-sites/combined,golden/filter-sites/combined.filter -exportType Hapmap
golden/filter-sites/combined.hmp.txt = exact

[filter-taxa]
description = FilterTaxaBuilderPlugin parameter sets; outputs are HapMap exports
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -FilterTaxaBuilderPlugin -minNotMissing 0.95 -endPlugin -export golden/filter-taxa/min-not-missing-0.95,golden/filter-taxa/min-not-missing-0.95.filter -exportType Hapmap
golden/filter-taxa/min-not-missing-0.95.hmp.txt = exact
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -FilterTaxaBuilderPlugin -minHeterozygous 0.005 -maxHeterozygous 0.02 -endPlugin -export golden/filter-taxa/het-0.005-0.02,golden/filter-taxa/het-0.005-0.02.filter -exportType Hapmap
golden/filter-taxa/het-0.005-0.02.hmp.txt = exact
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -FilterTaxaBuilderPlugin -taxaList W22,B73,CML247,33-16 -includeTaxa true -endPlugin -export golden/filter-taxa/include-list,golden/filter-taxa/include-list.filter -exportType Hapmap
golden/filter-taxa/include-list.hmp.txt = exact
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -FilterTaxaBuilderPlugin -taxaList W22,B73,CML247,33-16 -includeTaxa false -endPlugin -export golden/filter-taxa/exclude-list,golden/filter-taxa/exclude-list.filter -exportType Hapmap
golden/filter-taxa/exclude-list.hmp.txt = exact

[kinship]
description = KinshipPlugin Centered_IBS with defaults; TASSEL square-matrix text (float values)
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -KinshipPlugin -method Centered_IBS -endPlugin -export golden/kinship/centered_ibs -exportType SqrMatrix
golden/kinship/centered_ibs.txt = abs 8e-6

[pca]
description = PrincipalComponentsPlugin defaults (covariance, 5 components); PCs are stored as floats
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -PrincipalComponentsPlugin -endPlugin -export golden/pca/pcs,golden/pca/eigenvalues,golden/pca/eigenvectors
command = tassel5-full -h tutorial/mdp_genotype.hmp.txt -PrincipalComponentsPlugin -endPlugin -export golden/pca/pcs.full,golden/pca/eigenvalues.full,golden/pca/eigenvectors.full
golden/pca/pcs.txt = format
golden/pca/eigenvalues.txt = exact rows-unordered
golden/pca/eigenvectors.txt = format
golden/pca/pcs.full.txt = abs 1e-5 up-to-sign
golden/pca/eigenvalues.full.txt = rel 1e-9 rows-unordered
golden/pca/eigenvectors.full.txt = abs 1e-9 up-to-sign
