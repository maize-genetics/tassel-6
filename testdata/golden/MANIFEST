command = tassel5 -h tutorial/mdp_genotype.hmp.txt -export golden/vcf-export/mdp_genotype -exportType VCF
golden/vcf-export/mdp_genotype.vcf = exact
command = tassel5 -h tutorial/mdp_genotype.hmp.txt -FilterTaxaBuilderPlugin -taxaList W22,B73,CML247,33-16 -includeTaxa true -endPlugin -export golden/vcf-export/include-list,golden/vcf-export/include-list.filter -exportType VCF
golden/vcf-export/include-list.vcf = exact
command = tassel5 -h tutorial/vcf_export_edges.hmp.txt -export golden/vcf-export/vcf_export_edges -exportType VCF
golden/vcf-export/vcf_export_edges.vcf = exact

[summary]
