# htslib 1.25 fixtures for compressed and indexed VCF (ADR-0021, tassel-6#80).
# Generated by scripts/generate-htslib-fixtures.sh. Do not edit by hand.
#
# Paths are relative to testdata/, and every command runs from there.
#   file     may repeat; each value is one output file
#   command  may repeat; the invocation that produced the following file
# CSI min_shift and depth are read back from the index header.
# Both bcftools region-overlap modes are kept. ADR-0021 chooses record for the
# reader; this oracle does not make that choice.
#
[htslib]
version = 1.25
bgzip = bgzip (htslib) 1.25
tabix = tabix (htslib) 1.25
bcftools = bcftools 1.25
bcftools_htslib = Using htslib 1.25
gzip = Apple gzip 487.0.1

[tutorial]
# bgzip of tutorial/mdp_genotype_w_depth.vcf. That file has no ##contig lines.
# htslib 1.25 writes this CSI with depth 8. Readers must take min_shift and depth from the file.
# bcftools index -s prints [W::bcf_hdr_check_sanity] warnings about PL and GQ on stderr; only stdout is kept.
# Chromosome 1 of the tutorial is 3.18 MB of records. Dumping it whole, twice, would put the tree over the 10 MB cap,
# so the whole-contig oracle is wheat chr3B. The tutorial range below still crosses several BGZF blocks.
command = bgzip -c tutorial/mdp_genotype_w_depth.vcf
file = htslib/tutorial/mdp_genotype_w_depth.vcf.gz
command = bcftools index -c htslib/tutorial/mdp_genotype_w_depth.vcf.gz
file = htslib/tutorial/mdp_genotype_w_depth.vcf.gz.csi
csi_min_shift = 14
csi_depth = 8
command = tabix -p vcf htslib/tutorial/mdp_genotype_w_depth.vcf.gz
file = htslib/tutorial/mdp_genotype_w_depth.vcf.gz.tbi
command = bcftools index -s htslib/tutorial/mdp_genotype_w_depth.vcf.gz
file = htslib/tutorial/index-s.txt
command = tabix -l htslib/tutorial/mdp_genotype_w_depth.vcf.gz
file = htslib/tutorial/contigs.txt
bgzf_data_blocks = 287

[tutorial-regions]
# Queries are beg-end, and a single position is pos-pos, so this oracle does not depend on how chr:pos is parsed.
# Stderr is discarded: bcftools view repeats the PL/GQ header warning.
command = bcftools view -H --regions-overlap record -r 1:157104-157104 htslib/tutorial/mdp_genotype_w_depth.vcf.gz
file = htslib/tutorial/regions/1_157104_157104.record.txt
command = bcftools view -H --regions-overlap pos -r 1:157104-157104 htslib/tutorial/mdp_genotype_w_depth.vcf.gz
file = htslib/tutorial/regions/1_157104_157104.pos.txt
command = bcftools view -H --regions-overlap record -r 1:157104-10068726 htslib/tutorial/mdp_genotype_w_depth.vcf.gz
file = htslib/tutorial/regions/1_157104_10068726.record.txt
