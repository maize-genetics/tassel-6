[golden-bcf]
# htslib 1.25 BCF encodings of the TASSEL 5 VCF-export goldens (tassel-6#119).
# A golden is TASSEL 5 text. These files are htslib's framing of that text. The two oracles stay distinct (ADR-0022).
# Editing these files does not use the golden-update label, and testdata/golden/ is not modified.
# Each golden has no ##contig lines, so bcftools view -Ob refuses the plain VCF.
# The route is bgzip, bcftools index -c, then bcftools view --no-version -Ob of the bgzipped file. The .vcf.gz and .csi stay in scratch.
# blocks.txt is one decimal BSIZE+1 per BGZF member, including the 28-byte EOF member, from the same walk as walk_bgzf.
# Level-0 binaries are not stored. The full tutorial at level 0 is about 18.7 MB and the GT-only tutorial at level 0 is about 1.9 MB.
# smallest_golden is the golden with the fewest bytes. level0_blocks_match says whether -Ob and -Ob -l 0 share a member-size list for that golden.
# When they differ, the level-0 list is committed as text and the level-0 binary is deleted. #130's stored writer matches that list when the file exists, and the -Ob list otherwise.
# Inflated bytes always come from the committed -Ob BCF.
smallest_golden = vcf_export_edges
command = bgzip -c golden/vcf-export/mdp_genotype.vcf
command = bcftools index -c
command = bcftools view --no-version -Ob -o htslib/bcf/golden/mdp_genotype.bcf
